{
  "schemaVersion": 2,
  "id": "org.marginalia.examples.declarative-theme-v2",
  "name": "Declarative Dark Mode",
  "version": "0.1.0",
  "dataSchema": 1,
  "summary": "A manifest v2 OS-wide inverted screen theme",
  "author": "Marginalia",
  "license": "MIT",
  "target": {
    "devices": ["xteink-x3", "xteink-x4"],
    "architectures": ["esp32-c3"],
    "osApi": {"major": 1, "minMinor": 0},
    "minFirmware": "1.3.0",
    "ramClass": "low",
    "requiresPSRAM": false
  },
  "components": [
    {
      "id": "theme",
      "type": "contribution",
      "contract": "theme/1",
      "activation": "always",
      "requires": ["display", "package.settings"],
      "descriptor": "src/theme.json"
    }
  ],
  "settings": [
    {
      "id": "invertScreen",
      "label": "Invert screen",
      "type": "boolean",
      "default": true
    }
  ],
  "dependencies": [],
  "integrity": {
    "sha256": "replace-me"
  }
}
