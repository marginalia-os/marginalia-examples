{
  "schemaVersion": 1,
  "id": "org.marginalia.integrations.project-gutenberg",
  "name": "Project Gutenberg",
  "version": "0.1.0",
  "kind": "integration",
  "execution": "module",
  "summary": "Adds Project Gutenberg as a free public-domain book catalog",
  "author": "Marginalia",
  "license": "MIT",
  "target": {
    "devices": ["xteink-x3", "xteink-x4"],
    "chipFamilies": ["esp32-c3"],
